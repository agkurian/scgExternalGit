@startuml scg_upload_workflow_dependency
' Pure class diagram: stable rendering in VS Code PlantUML preview
set namespaceSeparator none
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 35
skinparam roundcorner 8
skinparam ArrowThickness 1.2
skinparam ArrowColor #2E2E2E
skinparam PackageBorderColor #6B6B6B
skinparam PackageBackgroundColor #FFFFFF
skinparam package<<external>>BackgroundColor #FFF8E1
skinparam package<<external>>BorderColor #C2A66A
skinparam package<<gui>>BackgroundColor #F1F8FF
skinparam package<<gui>>BorderColor #6B8FB3
skinparam ClassBorderColor #6B6B6B
skinparam ClassBackgroundColor #FFFFFF
hide empty members

legend right
  **Arrow colors by flow category:**
  <color:#1565C0>━━</color> Blue : UX triggers
  <color:#E65100>━━</color> Orange : SCG workflow dispatch
  <color:#6A1B9A>━━</color> Purple : gRPC / service chain
  <color:#C62828>━━</color> Red : configuration reads
endlegend

left to right direction

package "gui" as gui_amesim_gui <<gui>> {
  package "amesim_suite/amesim_gui" as P_amesim_gui {
    package "sim_data_display" as P_display {
      class SIMSCGCollectionViewerWidget
      class SIMSCGModelCollectionViewerWidget
      class SIMSCGCollectionLibraryViewerWidget

      SIMSCGModelCollectionViewerWidget -|> SIMSCGCollectionViewerWidget
      SIMSCGCollectionLibraryViewerWidget -|> SIMSCGCollectionViewerWidget
    }

    package "sim_dialogs" as P_dialogs {
      class SIMSCGConnectorPublishWidget
    }

    package "sysdm_integration" as P_sysdm {
      class "scg::SCGIntegration" as SCGIntegration
      abstract class SCGWorkflow
      class SCGPublishCollectionWorkflow
      class SCGSaveLibraryWorkflow
      class SCGPublishLibraryAgainWorkflow
      class SCGAnswer

      class SCGUXMessenger
      class SCGFileDialogWrapper

      SCGPublishCollectionWorkflow -|> SCGWorkflow
      SCGSaveLibraryWorkflow -|> SCGWorkflow
      SCGPublishLibraryAgainWorkflow -|> SCGSaveLibraryWorkflow
      SCGPublishCollectionWorkflow o-- SCGAnswer : answers

      SCGIntegration *-- SCGUXMessenger
      SCGFileDialogWrapper o-- SIMSCGConnectorPublishWidget
    }
  }
}

package "transverse/scg_adapter" as transverse_scg_adapter {
  package "scg_base" as P_scg_base {
    class MLMConfig
  }

  package "sysdm_service" as P_service {
    class SCGService
    class "SysDMRequestFactory" as SCGRequestFactory

    abstract class SCGRequest

    class SCGGetCEAStringRequest
    class SCGSetServerMetaDataRequest
    class SCGGetServerMetaDataRequest
    class SCGSaveCollectionRequest

    interface SCGConnectorAPIInterface
    class SCGConnectorAPIInterfaceImpl

    SCGGetCEAStringRequest -|> SCGRequest
    SCGSetServerMetaDataRequest -|> SCGRequest
    SCGGetServerMetaDataRequest -|> SCGRequest
    SCGSaveCollectionRequest -|> SCGRequest
    SCGConnectorAPIInterfaceImpl ..|> SCGConnectorAPIInterface
  }

  package "mlm_data_manager" as P_mlm {
    interface DataManagerInterface
    class DataManagerImpl
    class ConnectionManager

    package "extractor" as P_extractor {
      class "extractor::CEASettings" as CEASettings
      class "extractor::ExtractorCoreService" as ExtractorCoreService
      class "extractor::CEACreator" as CEACreator
      class "extractor::CollectionCompleteInput" as CollectionCompleteInput
      class "extractor::MessageMapperVisitor" as MessageMapperVisitor
    }

    DataManagerImpl ..|> DataManagerInterface
    DataManagerImpl ..> ExtractorCoreService : getPreprocessedDependencyXML()
    ExtractorCoreService ..> CEACreator
  }
}

package "transverse/pack_file/pack_kernel" as transverse_pack_kernel {
  class AMEKernelPackSettings
  class AMEKernelPackManager
  class AMEPackDependencyContainer

  AMEKernelPackManager ..> AMEKernelPackSettings
  AMEKernelPackManager o-- AMEPackDependencyContainer
}

package "External / SCG system" as external_scg <<external>> {
  package "Local SCG configuration" as P_scg_config {
    class "scg_config.properties" as ScgConfigProperties <<config file>>
    class "%APPDATA%/Simcenter/scg/config" as ScgConfigDirWin <<Windows path>>
    class "$HOME/.Simcenter/.scg/config" as ScgConfigDirLnx <<Linux path>>
  }

  package "Local SCG Core" as P_scg_core {
    class Stub <<gRPC stub>>
    class "SCG Core" as ScgCore <<local gRPC endpoint>>
  }

  package "Remote SCG Server" as P_remote_scg {
    class "SCG Server" as ScgServer <<remote>>
  }
}

' Stable group ordering
gui_amesim_gui -[hidden]right-> transverse_scg_adapter
transverse_scg_adapter -[hidden]right-> transverse_pack_kernel
transverse_pack_kernel -[hidden]right-> external_scg

' =====================================
' Upload / publish workflow
' =====================================

' Entry: Web UX "Upload" -> virtual upload() on the active viewer
SIMSCGCollectionViewerWidget -[#1565C0]-> SIMSCGModelCollectionViewerWidget : <color:#1565C0>upload()</color>\n<color:#1565C0>(virtual)</color>
SIMSCGCollectionViewerWidget -[#1565C0]-> SIMSCGCollectionLibraryViewerWidget : <color:#1565C0>upload()</color>\n<color:#1565C0>(virtual)</color>

' Model viewer: upload leads to SaveModelAgain dialog
SIMSCGModelCollectionViewerWidget -[#E65100]-> SCGFileDialogWrapper : <color:#E65100>launchSaveModelAgainDialog()</color>

' Publish widget triggers upload/publish
SIMSCGConnectorPublishWidget -[#E65100]-> SCGIntegration : <color:#E65100>publishModel(...)</color>
SCGIntegration -[#E65100]-> SCGPublishCollectionWorkflow : <color:#E65100>create + start</color>

' Library viewer: upload leads to SaveLibraryAgain flow
SIMSCGCollectionLibraryViewerWidget -[#E65100]-> SCGFileDialogWrapper : <color:#E65100>saveLibraryAgain()</color>
SCGFileDialogWrapper -[#E65100]-> SCGIntegration : <color:#E65100>saveLibraryToSCGAgain(...)</color>
SCGIntegration -[#E65100]-> SCGPublishLibraryAgainWorkflow : <color:#E65100>create + executeSCGWorkflow()</color>

' =====================================
' Service chain (purple)
' =====================================

SCGPublishCollectionWorkflow -[#6A1B9A]-> SCGRequestFactory : <color:#6A1B9A>creates request objects</color>
SCGPublishCollectionWorkflow -[#6A1B9A]-> SCGService : <color:#6A1B9A>dispatches requests</color>
SCGPublishCollectionWorkflow ..[#6A1B9A]..> SCGGetCEAStringRequest
SCGPublishCollectionWorkflow ..[#6A1B9A]..> SCGSetServerMetaDataRequest
SCGPublishCollectionWorkflow ..[#6A1B9A]..> SCGGetServerMetaDataRequest
SCGPublishCollectionWorkflow ..[#6A1B9A]..> SCGSaveCollectionRequest
SCGService -[#6A1B9A]-> SCGRequest : <color:#6A1B9A>execute()</color>

SCGPublishLibraryAgainWorkflow -[#6A1B9A]-> SCGRequestFactory : <color:#6A1B9A>creates request objects</color>
SCGPublishLibraryAgainWorkflow -[#6A1B9A]-> SCGService : <color:#6A1B9A>dispatches requests</color>

SCGRequest -[#6A1B9A]-> SCGConnectorAPIInterface : <color:#6A1B9A>delegates to API</color>\n<color:#6A1B9A>(createOrEditCollection,</color>\n<color:#6A1B9A> setServerMetadata,</color>\n<color:#6A1B9A> getServerMetadata,</color>\n<color:#6A1B9A> saveCollection)</color>
SCGConnectorAPIInterfaceImpl -[#6A1B9A]-> DataManagerInterface : <color:#6A1B9A>createOrEditCollection/saveCollection</color>\n<color:#6A1B9A>setServerMetadata/getServerMetadata</color>

' createOrEditCollection() internally uses extractor
DataManagerImpl -[#6A1B9A]-> CEASettings : <color:#6A1B9A>configure</color>\n<color:#6A1B9A>(node/category)</color>
DataManagerImpl -[#6A1B9A]-> ExtractorCoreService : <color:#6A1B9A>GetCollectionCompleteInput(...)</color>
ExtractorCoreService -[#6A1B9A]-> CEACreator : <color:#6A1B9A>buildCollection()/resolveDependencies()</color>
ExtractorCoreService -[#6A1B9A]-> CollectionCompleteInput
DataManagerImpl -[#6A1B9A]-> MessageMapperVisitor : <color:#6A1B9A>mappedOutput(...)</color>

' Extractor uses kernel-side pack dependency discovery
CEACreator -[#6A1B9A]-> AMEKernelPackSettings
CEACreator -[#6A1B9A]-> AMEKernelPackManager
CEACreator -[#6A1B9A]-> AMEPackDependencyContainer

' gRPC chain to SCG Core
DataManagerImpl -[#6A1B9A]-> ConnectionManager : <color:#6A1B9A>gRPC</color>
ConnectionManager -[#6A1B9A]-> Stub : <color:#6A1B9A>createOrEditCollection()</color>\n<color:#6A1B9A>setServerMetadata()</color>\n<color:#6A1B9A>getServerMetadata()</color>\n<color:#6A1B9A>saveCollection()</color>
Stub -[#6A1B9A]-> ScgCore : <color:#6A1B9A>localhost:<grpc_port></color>

ScgCore ..[#6A1B9A]..> ScgServer : <color:#6A1B9A>configureServer / publish</color>\n<color:#6A1B9A>(out of process)</color>

' =====================================
' Configuration reads (red)
' =====================================

MLMConfig -[#C62828]-> ScgConfigProperties : <color:#C62828>reads tokens</color>\n<color:#C62828>workflow_port / server_port / grpc_port</color>
ScgConfigProperties -[#C62828]-> ScgConfigDirWin
ScgConfigProperties -[#C62828]-> ScgConfigDirLnx

ConnectionManager -[#C62828]-> MLMConfig : <color:#C62828>GetScgGrpcPort(); check localhost port</color>

note right of SCGPublishCollectionWorkflow
  Workflow varies slightly by first publish vs republish:
  - first publish: createOrEditCollection + setServerMetadata
  - republish: also getServerMetadata + saveCollection
end note

note right of SCGService
  Responses/errors propagate back via SCGAnswer objects.
end note

@enduml
