@startuml scg_download_open_model_workflow_dependency
' Pure class diagram: stable rendering in VS Code PlantUML preview
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 35
skinparam roundcorner 8
skinparam ArrowThickness 1.2
skinparam ArrowColor #2E2E2E
skinparam PackageBorderColor #6B6B6B
skinparam PackageBackgroundColor #FFFFFF
skinparam package<<external>>BackgroundColor #FFF8E1
skinparam package<<external>>BorderColor #C2A66A
skinparam package<<gui>>BackgroundColor #F1F8FF
skinparam package<<gui>>BorderColor #6B8FB3
skinparam ClassBorderColor #6B6B6B
skinparam ClassBackgroundColor #FFFFFF
skinparam wrapWidth 240
hide empty members

top to bottom direction

legend right
  <color:#1565C0>Blue</color> : workflow / message / call
  <color:#6B6B6B>Gray</color> : dependency / uses (static)
endlegend

' Encourage stable top-to-bottom placement of the big groups
gui_amesim_gui -[hidden]down-> transverse_scg_adapter
transverse_scg_adapter -[hidden]down-> external_third_party

package "gui/amesim_suite/amesim_gui" as gui_amesim_gui <<gui>> {
  package "sim_main_window" as P_main_window {
    class SIMMainWindow
    class "SIMDownloadModelWidget" as SIMDownloadModelWidget

    class "QWebEngineView" as QWebEngineView
    class "ClientForGit UX (Web app)" as SCGUX

    QWebEngineView -[#1565C0]-> SCGUX : loads URL
  }

  package "sysdm_integration" as P_sysdm {
    class "SCGFileDialogWrapper" as SCGFileDialogWrapper
    class "QTabWidget" as QTabWidget

    class "scg::SCGIntegration" as SCGIntegration

    abstract class SCGWorkflow
    abstract class SCGAccessModelWorkflow
    class SCGOpenModelWorkflow
    class SCGDownloadCollectionWorkflow

    class SCGUXMessenger

    SCGOpenModelWorkflow -|> SCGAccessModelWorkflow
    SCGAccessModelWorkflow -|> SCGWorkflow
    SCGDownloadCollectionWorkflow -|> SCGWorkflow

    SCGFileDialogWrapper *-- QTabWidget
    SCGIntegration *-- SCGUXMessenger
  }

  SIMMainWindow -[#1565C0]-> SCGFileDialogWrapper : new(..., DOWNLOAD_MODEL_DLG)
  SCGFileDialogWrapper -[#1565C0]-> SCGIntegration : openModel(this)

  SCGOpenModelWorkflow -[#1565C0]-> SIMDownloadModelWidget : retrieveData()
  SCGOpenModelWorkflow -[#1565C0]-> SCGAccessModelWorkflow : start() / checkLogin()
  SCGAccessModelWorkflow -[#1565C0]-> SIMDownloadModelWidget : (shown in wrapper stack)

  SIMDownloadModelWidget -[#1565C0]-> QWebEngineView : setUrl(repository?customconfig=...)
  SCGUXMessenger -[#1565C0]-> SIMDownloadModelWidget : messageReceived(type="SelectionChange")

  SIMDownloadModelWidget -[#1565C0]-> SCGIntegration : getDownloadCollection(branchVersionId, checkoutPath, ...)

  ' Encourage stable ordering within this group
  P_main_window -[hidden]down-> P_sysdm
}

package "transverse/scg_adapter" as transverse_scg_adapter {
  package "sysdm_service" as P_service {
    class SCGService
    class "SysDMRequestFactory" as SCGRequestFactory

    abstract class SCGRequest
    class SCGAnswer

    class SCGDownloadCollectionRequest
    class SCGDownloadCollectionAnswer

    class SCGGetContainingCollectionRequest
    class SCGGetContainingCollectionAnswer

    interface SCGConnectorAPIInterface
    class GITConnectorAPIImpl

    SCGDownloadCollectionRequest -|> SCGRequest
    SCGGetContainingCollectionRequest -|> SCGRequest
    GITConnectorAPIImpl ..|> SCGConnectorAPIInterface

    SCGService o-- SCGRequestFactory
    SCGService o-- SCGConnectorAPIInterface
  }

  package "mlm_data_manager" as P_mlm {
    interface DataManagerInterface
    class DataManagerImpl

    class GrpcCouplingMethods
    class ConnectionManager

    DataManagerImpl ..|> DataManagerInterface
    DataManagerImpl ..[#6B6B6B]..> GrpcCouplingMethods
    GrpcCouplingMethods ..[#6B6B6B]..> ConnectionManager
  }

  package "scg_base" as P_scg_base {
    class MLMConfig
  }

  GITConnectorAPIImpl -[#1565C0]-> DataManagerInterface
  DataManagerImpl ..[#1565C0]..> MLMConfig : reads ports/paths

  ' Encourage stable ordering within this group
  P_service -[hidden]down-> P_mlm
  P_mlm -[hidden]down-> P_scg_base
}

package "External / Third-party" as external_third_party <<external>> {
  package "Local SCG configuration" as P_scg_config {
    class "scg_config.properties" as ScgConfigProperties <<config file>>
    class "%APPDATA%/Simcenter/scg/config" as ScgConfigDirWin <<Windows path>>
    class "$HOME/.Simcenter/.scg/config" as ScgConfigDirLnx <<Linux path>>
  }

  package "Local SCG Core" as P_scg_core {
    class "SCG Core gRPC endpoint" as SCGCoreGrpc
    class Stub <<gRPC stub>>

    SCGCoreGrpc : host=localhost
    SCGCoreGrpc : port=<grpc_port>
  }

  ' Encourage stable ordering within this group
  P_scg_config -[hidden]down-> P_scg_core
}

' =====================================
' File->Open -> SCG tab -> download -> open
' =====================================

SCGIntegration -[#1565C0]-> SCGOpenModelWorkflow : executeSCGWorkflow()

' Download: SysDM workflow + requests
SCGIntegration -[#1565C0]-> SCGDownloadCollectionWorkflow : executeSCGWorkflow()

SCGDownloadCollectionWorkflow -[#1565C0]-> SCGRequestFactory : creatRequesteDownloadCollection(...)
SCGRequestFactory -[#1565C0]-> SCGDownloadCollectionRequest
SCGDownloadCollectionWorkflow -[#1565C0]-> SCGService : dispatchRequest()

SCGDownloadCollectionRequest -[#1565C0]-> SCGConnectorAPIInterface : downloadCollection(user, params)
SCGConnectorAPIInterface -[#1565C0]-> DataManagerInterface : downloadCollection(...)

ConnectionManager -[#1565C0]-> Stub : CreateChannel("localhost:<grpc_port>")
Stub -[#1565C0]-> SCGCoreGrpc : gRPC calls

SCGDownloadCollectionWorkflow -[#1565C0]-> SCGRequestFactory : createRequestGetContainingCollection(user, collectionId)
SCGRequestFactory -[#1565C0]-> SCGGetContainingCollectionRequest
SCGDownloadCollectionWorkflow -[#1565C0]-> SCGService : dispatchRequest()

SCGGetContainingCollectionRequest -[#1565C0]-> SCGConnectorAPIInterface : getContainingCollection(user, collectionId)
SCGConnectorAPIInterface -[#1565C0]-> DataManagerInterface : getContainingCollection(...)

' Open the downloaded .ame
SCGDownloadCollectionWorkflow -[#1565C0]-> SCGIntegration : load(<downloaded .ame path>)
SCGIntegration -[#1565C0]-> SIMMainWindow : signalLoad(path) -> slotLoad()

MLMConfig -[#1565C0]-> ScgConfigProperties : reads workflow_port / server_port / grpc_port
ScgConfigProperties -[#1565C0]-> ScgConfigDirWin
ScgConfigProperties -[#1565C0]-> ScgConfigDirLnx

note bottom of SIMDownloadModelWidget
  The SCG tab embeds the ClientForGit web UX.
  It listens to SCG UX websocket messages via SCGUXMessenger.

  Expected UX message shape:
  - type: "SelectionChange"
  - selectedObjects[].uid (branchVersionId)
  - selectedObjects[].collectionName
  - selectedObjects[].collectionType
  - selectedObjects[].classificationId

  URL pattern (simplified):
  http://localhost:<workflow_port>/repository
    ?clientId=UX_CLIENT
    &customconfig=amesim_getmodel
    &wsPort=<ux_ws_port>
    &restPort=<server_port>

  Library download uses the same widget flow,
  but customconfig=amesim_getlibrary.
end note

note bottom of SIMMainWindow
  This flow is distinct from opening an existing local .ame file:
  - Entry point is File->Open with an SCG-enabled dialog (DOWNLOAD_MODEL_DLG).
  - The download workflow opens the downloaded .ame via SCGIntegration::load().

  After the .ame is opened, the regular "open local .ame" SCG-dock workflow applies.
  See: scg_open_ame_file_dependency.puml
end note

@enduml
