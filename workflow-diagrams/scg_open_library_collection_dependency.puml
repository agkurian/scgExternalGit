@startuml scg_open_library_collection_dependency
' Pure class diagram: stable rendering in VS Code PlantUML preview
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 35
skinparam roundcorner 8
skinparam ArrowThickness 1.2
skinparam ArrowColor #2E2E2E
skinparam PackageBorderColor #6B6B6B
skinparam PackageBackgroundColor #FFFFFF
skinparam package<<external>>BackgroundColor #FFF8E1
skinparam package<<external>>BorderColor #C2A66A
skinparam package<<gui>>BackgroundColor #F1F8FF
skinparam package<<gui>>BorderColor #6B8FB3
skinparam ClassBorderColor #6B6B6B
skinparam ClassBackgroundColor #FFFFFF
skinparam wrapWidth 240
hide empty members

legend right
  <color:#1565C0>Blue</color> : workflow / message / call
  <color:#6B6B6B>Gray</color> : dependency / uses (static)
endlegend

top to bottom direction

' Encourage stable top-to-bottom placement of the big groups
gui_amesim_gui -[hidden]down-> gui_common_gui
gui_common_gui -[hidden]down-> transverse_scg_adapter
transverse_scg_adapter -[hidden]down-> external_third_party

package "gui/amesim_suite/amesim_gui" as gui_amesim_gui <<gui>> {
  package "category_manip" as P_category_manip {
    class SIMPathListDialog
    class "COMDockWindow (Library collection editor)" as LibraryCollectionDock
    class QFrame

    SIMPathListDialog *-- QFrame
    SIMPathListDialog *-- LibraryCollectionDock
  }

  package "sim_data_display" as P_display {
    class SIMSCGCollectionViewerWidget
    class SIMSCGCollectionLibraryViewerWidget

    class "QWebEngineView" as QWebEngineView
    class "QWebEngineProfile" as QWebEngineProfile

    SIMSCGCollectionLibraryViewerWidget -|> SIMSCGCollectionViewerWidget
    SIMSCGCollectionViewerWidget o-- QWebEngineView
    QWebEngineView -[#6B6B6B]-> QWebEngineProfile
  }

  package "sysdm_integration" as P_sysdm {
    class "scg::SCGIntegration" as SCGIntegration
    class "scg::SCGIntegrationPrivate" as SCGIntegrationPrivate
    class SCGUXMessenger

    abstract class SCGWorkflow
    class SCGGetCollectionIdWorkflow

    SCGIntegration *-- SCGIntegrationPrivate
    SCGIntegration *-- SCGUXMessenger
    SCGGetCollectionIdWorkflow -|> SCGWorkflow
  }

  SIMPathListDialog -[#1565C0]-> SIMPathListDialog : slotOpenCollectionViewer()
  SIMPathListDialog -[#1565C0]-> LibraryCollectionDock : create once + setWidget(...)
  SIMPathListDialog -[#1565C0]-> SIMSCGCollectionLibraryViewerWidget : create once
  SIMPathListDialog -[#1565C0]-> SIMSCGCollectionLibraryViewerWidget : updateLibraryCollectionViewerWidget()
  SIMPathListDialog -[#1565C0]-> SIMSCGCollectionLibraryViewerWidget : setupLibraryViewer()

  SIMSCGCollectionLibraryViewerWidget -[#1565C0]-> SCGIntegration : validateLibraryforCollectionEditor(path, collection_id)

  ' Encourage stable ordering within this group
  P_category_manip -[hidden]down-> P_display
  P_display -[hidden]down-> P_sysdm

  ' Keep common_gui close to the dialog that depends on it
  P_category_manip -[hidden]down-> gui_common_gui
}

package "gui/amesim_suite/common_gui" as gui_common_gui <<gui>> {
  package "category_manip" as common_category_manip {
    class COMPathListDialog
  }
}

SIMPathListDialog -|> COMPathListDialog
SIMPathListDialog -[hidden]down-> COMPathListDialog
LibraryCollectionDock -[hidden]down-> COMPathListDialog

package "transverse/scg_adapter" as transverse_scg_adapter {
  package "scg_base" as P_scg_base {
    class MLMConfig
    class scg_base <<cmake target>>
    scg_base o-- MLMConfig
  }

  package "sysdm_service" as P_service {
    class SCGService
    class "SysDMRequestFactory" as SCGRequestFactory

    abstract class SCGRequest
    class SCGGetCollectionIdRequest

    interface SCGConnectorAPIInterface
    class GITConnectorAPIImpl

    SCGGetCollectionIdRequest -|> SCGRequest
    GITConnectorAPIImpl ..|> SCGConnectorAPIInterface

    SCGService o-- SCGRequestFactory
    SCGService o-- SCGConnectorAPIInterface
  }

  package "mlm_data_manager" as P_mlm {
    interface DataManagerInterface
    class DataManagerImpl

    class GrpcCouplingMethods
    class ConnectionManager

    DataManagerImpl ..|> DataManagerInterface
    DataManagerImpl ..[#6B6B6B]..> GrpcCouplingMethods
    GrpcCouplingMethods ..[#6B6B6B]..> ConnectionManager
  }

  ' Encourage stable ordering within this group
  P_scg_base -[hidden]down-> P_service
  P_service -[hidden]down-> P_mlm
}

package "External / Third-party" as external_third_party <<external>> {
  package "Local SCG configuration" as P_scg_config {
    class "scg_config.properties" as ScgConfigProperties <<config file>>
    class "%APPDATA%/Simcenter/scg/config" as ScgConfigDirWin <<Windows path>>
    class "$HOME/.Simcenter/.scg/config" as ScgConfigDirLnx <<Linux path>>
  }

  package "Local SCG Core" as P_scg_core {
    class "SCG Core gRPC endpoint" as SCGCoreGrpc
    class Stub <<gRPC stub>>

    SCGCoreGrpc : host=localhost
    SCGCoreGrpc : port=<grpc_port>
  }

  package "Local SCG UX" as P_scg_ux {
    class "ClientForGit UX (Web app)" as SCGUX
    QWebEngineView -[#1565C0]-> SCGUX : loads URL
  }

  ' Encourage stable ordering within this group
  P_scg_config -[hidden]down-> P_scg_core
  P_scg_core -[hidden]down-> P_scg_ux
}

' =====================================
' Open library collection editor (PathList dialog)
' =====================================

SIMSCGCollectionLibraryViewerWidget -[#1565C0]-> SIMSCGCollectionViewerWidget : getCollectionEditorURL(path, CLIENT_ID_LIBRARY_VIEWER)
SIMSCGCollectionLibraryViewerWidget -[#1565C0]-> SIMSCGCollectionViewerWidget : setPageInWebView(path, url)
SIMSCGCollectionViewerWidget -[#1565C0]-> QWebEngineView : loads embedded web UI

SIMSCGCollectionViewerWidget -[#1565C0]-> SCGIntegration : getUXMessenger()

' SCG detection predicate used by setupLibraryViewer()
SCGIntegration -[#1565C0]-> SCGIntegrationPrivate : isManagedLocally(library_path, collection_id)
SCGIntegrationPrivate -[#1565C0]-> SCGGetCollectionIdWorkflow : getCollectionId()\nexecuteSCGWorkflow()

' Workflow dispatches SysDM request to resolve collection id
SCGGetCollectionIdWorkflow -[#1565C0]-> SCGRequestFactory : createRequestGetCollectionId(path, user)
SCGRequestFactory -[#1565C0]-> SCGGetCollectionIdRequest
SCGGetCollectionIdWorkflow -[#1565C0]-> SCGService : dispatchRequest()

SCGGetCollectionIdRequest -[#1565C0]-> SCGConnectorAPIInterface : getCollectionId(path, user)
SCGConnectorAPIInterface <|.. GITConnectorAPIImpl
GITConnectorAPIImpl -[#1565C0]-> DataManagerInterface
DataManagerInterface <|.. DataManagerImpl

ConnectionManager -[#1565C0]-> Stub : CreateChannel("localhost:<grpc_port>")
Stub -[#1565C0]-> SCGCoreGrpc : gRPC calls

' =====================================
' Local port + URL resolution (config)
' =====================================

MLMConfig -[#1565C0]-> ScgConfigProperties : reads tokens\nworkflow_port / server_port / grpc_port
ScgConfigProperties -[#1565C0]-> ScgConfigDirWin
ScgConfigProperties -[#1565C0]-> ScgConfigDirLnx

note bottom of SIMPathListDialog
  Entry point (Library collection editor):
  - SIMPathListDialog::slotOpenCollectionViewer() builds COMDockWindow
  - setupLibraryViewer() loads embedded SCG UX URL

  External Git / external-server collections:
  - Use the same open-viewer workflow and UI entry point
  - validateLibraryforCollectionEditor() allows SCG_EXTERNAL_SERVER collections

  URL params use:
  - restPort = workflow_port (MLMConfig / scg_config.properties)
  - wsPort   = SCGUXMessenger server port (SCGIntegration::getUXMessenger())
  - wsClientId = CLIENT_ID_LIBRARY_VIEWER
end note

@enduml
