@startuml scg_create_branch_and_switch_workflow_dependency
' Pure class diagram: stable rendering in VS Code PlantUML preview
set namespaceSeparator none
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 35
skinparam roundcorner 8
skinparam ArrowThickness 1.2
skinparam ArrowColor #2E2E2E
skinparam PackageBorderColor #6B6B6B
skinparam PackageBackgroundColor #FFFFFF
skinparam package<<external>>BackgroundColor #FFF8E1
skinparam package<<external>>BorderColor #C2A66A
skinparam package<<gui>>BackgroundColor #F1F8FF
skinparam package<<gui>>BorderColor #6B8FB3
skinparam ClassBorderColor #6B6B6B
skinparam ClassBackgroundColor #FFFFFF
hide empty members

legend right
  <color:#1565C0>Blue</color> : workflow / call
  <color:#6B6B6B>Gray</color> : dependency / uses (static)
endlegend

left to right direction

package "gui" as gui_amesim_gui <<gui>> {
  package "amesim_suite/amesim_gui" as P_amesim_gui {
    package "sim_main_window" as P_main_window {
      class SIMMainWindow
    }

    package "sim_gui_circuit_manip" as P_circuit_manip {
      class SIMCmdSCGCreateBranchAndSwitch

      SIMCmdSCGCreateBranchAndSwitch ..[#6B6B6B]..> SIMMainWindow : getMainWindow()
    }

    package "sysdm_integration" as P_sysdm {
      class "scg::SCGIntegration" as SCGIntegration

      SIMMainWindow ..[#6B6B6B]..> SCGIntegration : getSCGIntegration()
    }
  }
}

package "transverse/scg_adapter" as transverse_scg_adapter {
  package "sysdm_service" as P_service {
    class SCGService
    class "SysDMRequestFactory" as SCGRequestFactory
    class SCGAnswerWaiter

    abstract class SCGRequest

    class SCGCreateBranchAndSwitchRequest
    class SCGCreateBranchResponse

    interface SCGConnectorAPIInterface
    class SCGConnectorAPIInterfaceImpl

    SCGCreateBranchAndSwitchRequest -|> SCGRequest
    SCGConnectorAPIInterfaceImpl ..|> SCGConnectorAPIInterface

    ' Local ordering to keep arrows off the package title
    SCGService -[hidden]down-> SCGRequestFactory
    SCGRequestFactory -[hidden]down-> SCGCreateBranchAndSwitchRequest
    SCGCreateBranchAndSwitchRequest -[hidden]down-> SCGConnectorAPIInterface
    SCGConnectorAPIInterface -[hidden]down-> SCGConnectorAPIInterfaceImpl
  }

  package "mlm_data_manager" as P_mlm {
    interface DataManagerInterface
    class DataManagerImpl

    class ConnectionManager

    DataManagerImpl ..|> DataManagerInterface
    DataManagerImpl ..[#6B6B6B]..> ConnectionManager
  }
}

package "External / SCG system" as external_scg <<external>> {
  package "Local SCG Core" as P_scg_core {
    class Stub <<gRPC stub>>
    class "SCG Core" as ScgCore <<local gRPC endpoint>>
  }

  package "Remote SCG Server" as P_remote_scg {
    class "SCG Server" as ScgServer <<remote>>
  }
}

' Stable group ordering (GUI left -> adapter -> external right)
gui_amesim_gui -[hidden]right-> transverse_scg_adapter
transverse_scg_adapter -[hidden]right-> external_scg

' =========================
' Create Branch And Switch
' =========================

SIMCmdSCGCreateBranchAndSwitch -[#1565C0]-> SCGIntegration : createBranchAndSwitch(collectionId,\nbranchName, publishComments,\nresultCollectionId, branchVersionId, errorMsg)

SCGIntegration -[#1565C0]-> SCGRequestFactory : createRequestCreateBranch(userId, collectionId,\nbranchName, publishComments)
SCGIntegration -[#1565C0]-> SCGService : dispatchRequest()
SCGIntegration -[#1565C0]-> SCGAnswerWaiter : wait()
SCGService -[#1565C0]-> SCGRequest : execute()

SCGRequest -[#1565C0]-> SCGConnectorAPIInterface : createBranchAndSwitch(...)
SCGConnectorAPIInterfaceImpl -[#1565C0]-> DataManagerInterface : createBranchAndSwitch(...)
ConnectionManager -[#1565C0]-> Stub : createBranchAndSwitch()
Stub -[#1565C0]-> ScgCore : gRPC call\nlocalhost:<grpc_port>

ScgCore ..[#1565C0]..> ScgServer : branch+switch (out of process)

@enduml
