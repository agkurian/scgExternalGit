@startuml scg_resolve_conflict_workflow_dependency
' Pure class diagram: stable rendering in VS Code PlantUML preview
set namespaceSeparator none
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false
skinparam nodesep 30
skinparam ranksep 35
skinparam roundcorner 8
skinparam ArrowThickness 1.2
skinparam ArrowColor #2E2E2E
skinparam PackageBorderColor #6B6B6B
skinparam PackageBackgroundColor #FFFFFF
skinparam package<<external>>BackgroundColor #FFF8E1
skinparam package<<external>>BorderColor #C2A66A
skinparam package<<gui>>BackgroundColor #F1F8FF
skinparam package<<gui>>BorderColor #6B8FB3
skinparam ClassBorderColor #6B6B6B
skinparam ClassBackgroundColor #FFFFFF
skinparam wrapWidth 240
hide empty members

legend right
  <color:#1565C0>Blue</color> : workflow / message / call
  <color:#6B6B6B>Gray</color> : dependency / uses (static)
endlegend

left to right direction

package "gui" as gui_amesim_gui <<gui>> {
  package "amesim_suite/amesim_gui" as P_amesim_gui {
    package "sim_data_display" as P_sim_data_display {
      class "SIMSCGCollectionViewerWidget" as SIMSCGCollectionViewerWidget
      class "SIMSCGModelCollectionViewerWidget" as SIMSCGModelCollectionViewerWidget
      class "SIMSCGCollectionLibraryViewerWidget" as SIMSCGCollectionLibraryViewerWidget

      class "scg_ux_messenger_string" as scg_ux_messenger_string <<constants>>

      SIMSCGModelCollectionViewerWidget -|> SIMSCGCollectionViewerWidget
      SIMSCGCollectionLibraryViewerWidget -|> SIMSCGCollectionViewerWidget

      SIMSCGCollectionViewerWidget ..[#6B6B6B]..> scg_ux_messenger_string : UX_MESSAGE_RESOLVE_CONFLICT
      SIMSCGCollectionViewerWidget ..[#6B6B6B]..> scg_ux_messenger_string : UX_MESSAGE_BULKRESOLVE_CONFLICT
    }

    package "sysdm_integration" as P_sysdm {
      class "scg::SCGIntegration" as SCGIntegration
      class SCGUXMessenger
      class SCGFileDialogWrapper

      abstract class SCGWorkflow
      class SCGResolveMergeConflictWorkflow

      SCGResolveMergeConflictWorkflow -|> SCGWorkflow

      SCGIntegration *-- SCGUXMessenger

      SCGUXMessenger -[#1565C0]-> SIMSCGCollectionViewerWidget : messageReceived
      SIMSCGModelCollectionViewerWidget -[#1565C0]-> SCGIntegration : resolveMergeConflict(...)
      SCGIntegration -[#1565C0]-> SCGResolveMergeConflictWorkflow : create + executeSCGWorkflow()
      SIMSCGModelCollectionViewerWidget ..[#6B6B6B]..> SCGFileDialogWrapper : getSaveModelAgainWrapperDialog()
    }

    ' Encourage stable ordering within this group
    P_sim_data_display -[hidden]right-> P_sysdm
  }
}

package "transverse/scg_adapter" as transverse_scg_adapter {
  package "scg_base" as P_scg_base {
    class MLMConfig
  }

  package "sysdm_service" as P_service {
    class SCGService
    class "SysDMRequestFactory" as SCGRequestFactory

    abstract class SCGRequest
    class SCGAnswer

    class SCGResolveMergeConflictRequest
    class SCGResolveMergeConflictResponse

    class SCGGetCollectionMergeDetailsRequest
    class SCGGetCollectionMergeDetailsResponse

    interface SCGConnectorAPIInterface
    class SCGConnectorAPIInterfaceImpl

    SCGResolveMergeConflictRequest -|> SCGRequest
    SCGResolveMergeConflictResponse -|> SCGAnswer

    SCGGetCollectionMergeDetailsRequest -|> SCGRequest
    SCGGetCollectionMergeDetailsResponse -|> SCGAnswer

    SCGConnectorAPIInterfaceImpl ..|> SCGConnectorAPIInterface

    SCGService o-- SCGRequestFactory
    SCGService o-- SCGConnectorAPIInterface
  }

  package "mlm_data_manager" as P_mlm {
    interface DataManagerInterface
    class DataManagerImpl

    class ConnectionManager

    DataManagerImpl ..|> DataManagerInterface
    DataManagerImpl ..[#6B6B6B]..> ConnectionManager
  }
}

package "External / SCG system" as external_scg <<external>> {
  package "Local SCG UX" as P_scg_ux {
    class "SCG UX" as ScgUx <<local web app>>
  }

  package "Local SCG Core" as P_scg_core {
    class Stub <<gRPC stub>>
    class "SCG Core" as ScgCore <<local gRPC endpoint>>
    class "SCG REST API" as ScgRest <<local REST endpoint>>
    class "Server configuration store" as ServerStore <<config/persistency>>
  }

  package "Remote SCG Server" as P_remote {
    class "SCG Server" as ScgServer <<remote>>
  }
}

' Stable group ordering (GUI left -> adapter -> external right)
gui_amesim_gui -[hidden]right-> transverse_scg_adapter
transverse_scg_adapter -[hidden]right-> external_scg

' =====================================
' Resolve conflict (UX -> native -> gRPC)
' =====================================

' Setup: viewer obtains the UX messenger via SCGIntegration
SIMSCGCollectionViewerWidget -[#1565C0]-> SCGIntegration : getUXMessenger()
SCGIntegration -[#1565C0]-> SCGUXMessenger : returns messenger instance

ScgUx -[#1565C0]-> SCGUXMessenger : websocket message
SCGUXMessenger -[#1565C0]-> SIMSCGCollectionViewerWidget : slotOnUxMessengerMessageReceived(message)

' Base widget routes message based on clientId
note right of SIMSCGCollectionViewerWidget
  slotOnUxMessengerMessageReceived(message) routes by message.clientId:
  - CLIENT_ID_MODEL_VIEWER   -> modelViewerMessageReceived(message)
  - CLIENT_ID_LIBRARY_VIEWER -> libraryViewerMessageReceived(message)
end note

' Model viewer path: supported
SIMSCGCollectionViewerWidget -[#1565C0]-> SIMSCGModelCollectionViewerWidget : handle resolve-conflict (supported)
SIMSCGModelCollectionViewerWidget -[#1565C0]-> SCGIntegration : resolveMergeConflict(wrapper, message, error)

' Library viewer path: NOT supported (request is rejected)
SIMSCGCollectionViewerWidget -[#1565C0]-> SIMSCGCollectionLibraryViewerWidget : handle resolve-conflict (rejected)
SIMSCGCollectionLibraryViewerWidget -[#1565C0]-> SIMSCGCollectionLibraryViewerWidget : showNewC4GServerFeatureNotSupported("unsupported request")

' Resolve actions apply to the currently configured/active server session.
ScgCore ..[#1565C0]..> ServerStore : read configured servers\n(active selection/session)
ScgCore ..[#1565C0]..> ScgServer : forward operation\n(out of process)

SCGIntegration -[#1565C0]-> SCGResolveMergeConflictWorkflow : start()
SCGResolveMergeConflictWorkflow -[#1565C0]-> SCGRequestFactory : createRequestResolveMergeConflict(user, json)
SCGResolveMergeConflictWorkflow -[#1565C0]-> SCGService : dispatchRequest()

SCGService -[#1565C0]-> SCGResolveMergeConflictRequest : execute()
SCGResolveMergeConflictRequest -[#1565C0]-> SCGConnectorAPIInterface : resolveMergeConflict(user, request, error)

SCGConnectorAPIInterfaceImpl -[#1565C0]-> DataManagerInterface : resolveMergeConflict(user, request, error)

ConnectionManager -[#1565C0]-> Stub : gRPC\nresolveMergeConflict()
Stub -[#1565C0]-> ScgCore : localhost:<grpc_port>

' Optional: conflict detection reads merge details (used by GUI pre-checks)
SCGIntegration ..[#1565C0]..> SCGRequestFactory : createRequestGetCollectionMergeDetails(user, collectionId)
SCGService ..[#1565C0]..> SCGGetCollectionMergeDetailsRequest : execute()
SCGGetCollectionMergeDetailsRequest ..[#1565C0]..> SCGConnectorAPIInterface : getCollectionMergeDetails(...)
ConnectionManager ..[#1565C0]..> Stub : gRPC\ngetCollectionMergeDetails()

note right of SCGResolveMergeConflictRequest
  SCGResolveMergeConflictRequest parses the UX JSON and builds
  a CollectionConflictResolutionRequest + list of ConflictResolutionRequest.

  The request is then executed through:
  sysdm_service -> connector API -> data manager -> gRPC stub -> SCG Core.
end note

@enduml
